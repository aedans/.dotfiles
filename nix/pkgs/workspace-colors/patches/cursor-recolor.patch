+/**
+ * meta_cursor_tracker_set_recolor:
+ * @tracker: a #MetaCursorTracker
+ * @from: (nullable): a color the cursor theme draws its cursors with
+ * @to: (nullable): the color to draw them with instead
+ *
+ * Recolors the cursors drawn from the cursor theme: their pixels of @from,
+ * including where it blends into white, black or a grey, take @to in its
+ * place. Other colors are left alone, so @from should be one only the parts
+ * to recolor use. %NULL for either shows the cursors as the theme draws them.
+ * Cursors that clients draw themselves are left alone.
+ */
+void
+meta_cursor_tracker_set_recolor (MetaCursorTracker *tracker,
+                                 const CoglColor   *from,
+                                 const CoglColor   *to)
+{
+  MetaCursorTrackerPrivate *priv;
+
+  g_return_if_fail (META_IS_CURSOR_TRACKER (tracker));
+
+  priv = meta_cursor_tracker_get_instance_private (tracker);
+
+  if (from && to)
+    {
+      if (priv->has_recolor &&
+          cogl_color_equal (&priv->recolor_from, from) &&
+          cogl_color_equal (&priv->recolor_to, to))
+        return;
+
+      priv->has_recolor = TRUE;
+      priv->recolor_from = *from;
+      priv->recolor_to = *to;
+    }
+  else
+    {
+      if (!priv->has_recolor)
+        return;
+
+      priv->has_recolor = FALSE;
+    }
+
+  g_signal_emit (tracker, signals[CURSOR_RECOLOR_CHANGED], 0);
+}
+
+gboolean
+meta_cursor_tracker_get_recolor (MetaCursorTracker *tracker,
+                                 CoglColor         *from,
+                                 CoglColor         *to)
+{
+  MetaCursorTrackerPrivate *priv =
+    meta_cursor_tracker_get_instance_private (tracker);
+
+  if (priv->has_recolor)
+    {
+      *from = priv->recolor_from;
+      *to = priv->recolor_to;
+    }
+
+  return priv->has_recolor;
+}
