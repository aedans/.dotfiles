+/* Recolors premultiplied ARGB @pixels from @from to @to (see
+ * meta_cursor_tracker_set_recolor ()). A pixel blending @from into a grey has
+ * the same hue and the grey's level in each channel, so its share of @from is
+ * its chroma over @from's, and swapping that share for @to keeps the grey. */
+static void
+recolor_pixels (uint32_t        *pixels,
+                int              n_pixels,
+                const CoglColor *from,
+                const CoglColor *to)
+{
+  /* How far, in 0..1 per channel, a pixel's hue may stray from @from's for
+   * it to count as a blend of it, allowing for rounding. */
+  const float tolerance = 0.08f;
+  const float from_channels[] = {
+    cogl_color_get_red (from),
+    cogl_color_get_green (from),
+    cogl_color_get_blue (from),
+  };
+  const float to_channels[] = {
+    cogl_color_get_red (to),
+    cogl_color_get_green (to),
+    cogl_color_get_blue (to),
+  };
+  float from_min = MIN (from_channels[0], MIN (from_channels[1], from_channels[2]));
+  float from_max = MAX (from_channels[0], MAX (from_channels[1], from_channels[2]));
+  float from_chroma = from_max - from_min;
+  int i, c;
+
+  if (from_chroma == 0.0f)
+    return;
+
+  for (i = 0; i < n_pixels; i++)
+    {
+      uint32_t pixel = pixels[i];
+      uint32_t alpha = pixel >> 24;
+      float channels[3];
+      float min, max, share;
+      gboolean blend = TRUE;
+
+      if (alpha == 0)
+        continue;
+
+      for (c = 0; c < 3; c++)
+        channels[c] = (float) ((pixel >> (16 - 8 * c)) & 0xff) / alpha;
+
+      min = MIN (channels[0], MIN (channels[1], channels[2]));
+      max = MAX (channels[0], MAX (channels[1], channels[2]));
+      share = (max - min) / from_chroma;
+      if (share < 0.02f)
+        continue;
+
+      for (c = 0; c < 3; c++)
+        {
+          if (fabsf ((channels[c] - min) -
+                     share * (from_channels[c] - from_min)) > tolerance)
+            blend = FALSE;
+        }
+      if (!blend)
+        continue;
+
+      share = MIN (share, 1.0f);
+      pixel &= 0xff000000;
+      for (c = 0; c < 3; c++)
+        {
+          float channel = channels[c] + share * (to_channels[c] - from_channels[c]);
+
+          pixel |= (uint32_t) roundf (CLAMP (channel, 0.0f, 1.0f) * alpha) << (16 - 8 * c);
+        }
+      pixels[i] = pixel;
+    }
+}
