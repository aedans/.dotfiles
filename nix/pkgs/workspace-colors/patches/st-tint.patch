+/* St-specific extension: a tint and an accent, inherited like font
+ * properties, so that one rule on an ancestor recolors everything below it.
+ *
+ *   -st-tint-hue: <degrees>; -st-tint-saturation: <0..1>
+ *     Neutral greys take this hue and saturation and keep their lightness.
+ *     The tint fades out towards white, so whites stay white.
+ *   -st-tint-accent-color, -st-tint-accent-fg-color: <color>
+ *     What -st-accent-color and -st-accent-fg-color stand for, in place of
+ *     the system accent.
+ */
+
+/* Below this saturation a color counts as a neutral grey. */
+#define TINT_NEUTRAL_SATURATION 0.12
+/* Above this lightness the tint fades out. */
+#define TINT_FADE_LIGHTNESS 0.9
+
+static void
+ensure_tint (StThemeNode *node)
+{
+  double hue, saturation;
+
+  if (node->tint_computed)
+    return;
+
+  node->tint_computed = TRUE;
+  node->has_tint =
+    st_theme_node_lookup_double (node, "-st-tint-hue", TRUE, &hue) &&
+    st_theme_node_lookup_double (node, "-st-tint-saturation", TRUE, &saturation);
+
+  if (node->has_tint)
+    {
+      node->tint_hue = hue;
+      node->tint_saturation = saturation;
+    }
+}
+
+static void
+tint_color (StThemeNode *node,
+            CoglColor   *color)
+{
+  float hue, saturation, lightness, fade;
+  uint8_t alpha = color->alpha;
+
+  ensure_tint (node);
+  if (!node->has_tint)
+    return;
+
+  cogl_color_to_hsl (color, &hue, &saturation, &lightness);
+  if (saturation > TINT_NEUTRAL_SATURATION)
+    return;
+
+  fade = MIN (1.0, (1.0 - lightness) / (1.0 - TINT_FADE_LIGHTNESS));
+  cogl_color_init_from_hsl (color, node->tint_hue, node->tint_saturation * fade, lightness);
+  color->alpha = alpha;
+}
+
+static GetFromTermResult
+get_color_from_term (StThemeNode  *node,
+                     CRTerm       *term,
+                     CoglColor    *color)
+{
+  GetFromTermResult result = get_untinted_color_from_term (node, term, color);
+
+  if (result == VALUE_FOUND)
+    tint_color (node, color);
+
+  return result;
+}
