diff --git a/gtk/gtkmodules.c b/gtk/gtkmodules.c
index 01ad655..80fefd6 100644
--- a/gtk/gtkmodules.c
+++ b/gtk/gtkmodules.c
@@ -165,3 +165,65 @@ _gtk_get_module_path (const char *type)
 
   return result;
 }
+
+typedef void (*GtkModuleInitFunc) (void);
+
+static GModule *
+open_module (const char *name)
+{
+  char **paths;
+  char **path;
+  GModule *module = NULL;
+
+  if (g_path_is_absolute (name))
+    return g_module_open (name, G_MODULE_BIND_LOCAL | G_MODULE_BIND_LAZY);
+
+  paths = _gtk_get_module_path ("modules");
+  for (path = paths; *path && !module; path++)
+    {
+      char *file = g_module_build_path (*path, name);
+
+      if (g_file_test (file, G_FILE_TEST_EXISTS))
+        module = g_module_open (file, G_MODULE_BIND_LOCAL | G_MODULE_BIND_LAZY);
+      g_free (file);
+    }
+  g_strfreev (paths);
+
+  return module;
+}
+
+/**
+ * _gtk_modules_init:
+ *
+ * Loads the modules GTK_MODULES lists, as GTK 3 did: each is a path, or a
+ * name found as lib<name> in the "modules" directories of the module path.
+ * A module's gtk_module_init () runs once the default display is open.
+ */
+void
+_gtk_modules_init (void)
+{
+  const char *modules_env = g_getenv ("GTK_MODULES");
+  char **names;
+  char **name;
+
+  if (!modules_env)
+    return;
+
+  names = split_file_list (modules_env);
+  for (name = names; *name; name++)
+    {
+      GModule *module = open_module (*name);
+      GtkModuleInitFunc init;
+
+      if (!module)
+        {
+          g_message ("Failed to load module \"%s\"", *name);
+          continue;
+        }
+
+      g_module_make_resident (module);
+      if (g_module_symbol (module, "gtk_module_init", (gpointer *) &init))
+        init ();
+    }
+  g_strfreev (names);
+}
